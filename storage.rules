rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isImageFile() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnderMaxSize() {
      // 5 MB limit (client compresses images to < 70 KB via Canvas)
      return request.resource.size < 5 * 1024 * 1024;
    }

    // Project post images: public read, authenticated upload with size & content-type checks
    match /posts/{imageFile} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isImageFile() && isUnderMaxSize();
      allow delete: if isAuthenticated();
    }

    // Legacy or generic project images path
    match /project_images/{imageFile} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isImageFile() && isUnderMaxSize();
      allow delete: if isAuthenticated();
    }

    // User profile pictures: public read, owner update
    match /users/{userId}/{imageFile} {
      allow read: if true;
      allow create, update: if isAuthenticated() && request.auth.uid == userId && isImageFile() && isUnderMaxSize();
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny for all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
